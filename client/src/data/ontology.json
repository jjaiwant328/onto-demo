      "measure": "labor_cost_per_customer",
      "type": "derived",
      "unit": "usd_per_customer",
      "formula": "sum(total_labor_cost) / nullif(sum(total_customers), 0)",
      "description": "Labor cost per customer — primary efficiency KPI (lower is better).",
