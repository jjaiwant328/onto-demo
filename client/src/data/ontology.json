      "formula": "count(distinct case when outside_sale_flag = 'N' then coalesce(cust_id, txn_key) end)",
      "description": "Visits with an inside/shop sale (outside_sale_flag = 'N').",
      "depends_on": []
    },
    {
      "measure": "fuel_customers",
      "type": "base",
      "unit": "customers",
      "formula": "count(distinct case when outside_sale_flag = 'Y' then coalesce(cust_id, txn_key) end)",
      "description": "Visits with an outside-court/fuel sale (outside_sale_flag = 'Y').",
      "depends_on": []
    },
    {
      "measure": "dual_customers",
      "type": "base",
      "unit": "customers",
      "formula": "count(distinct case when has_shop = 1 and has_fuel = 1 then cust_id end)",
      "description": "Customers with BOTH shop and fuel activity on the same store-day. Loyalty-biased (requires a resolvable cust_id). See assumption A5.",
      "depends_on": []
    },
    {
      "measure": "total_labor_hours",
      "type": "base",
      "unit": "hours",
      "formula": "sum(labor_hours)",
      "description": "Total scheduled/worked labor hours at a store on a day.",
      "depends_on": []
    },
    {
      "measure": "total_labor_cost",
      "type": "base",
      "unit": "usd",
      "formula": "sum(labor_amount)",
      "description": "Total labor cost (amount) at a store on a day.",
      "depends_on": []
    },
    {
      "measure": "dual_customer_conversion_rate_pct",
      "type": "derived",
      "unit": "percent",
      "formula": "100.0 * sum(dual_customers) / nullif(sum(total_customers), 0)",
      "description": "Share of customers who bought both shop and fuel.",
      "depends_on": [
