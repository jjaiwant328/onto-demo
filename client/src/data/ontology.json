  "measures": [
    {
      "measure": "total_customers",
      "type": "base",
      "unit": "customers",
      "formula": "count(distinct coalesce(cust_id, txn_key))",
      "description": "Distinct customer visits at a store on a day. Uses cust_id when present, else distinct transaction key (anonymous visits).",
